# Master Arena SaaS - Root Directory Rewrite
# Comments strictly in ASCII only.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS redirect for all traffic
    # Supports direct SSL, Locaweb reverse proxy and Cloudflare
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteCond %{REQUEST_URI} !^/database/(web_setup|create_users)\.php
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Allow direct access to database web installer tools
    RewriteCond %{REQUEST_URI} ^/database/(web_setup|create_users)\.php
    RewriteRule ^ - [L]

    # Protect sensitive files and directories
    RewriteRule ^(\.env|config/|storage/|app/) - [F,L]

    # Route all other web traffic to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    # Security Headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
